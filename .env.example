# LLM Provider: "groq" (free tier, default), "ollama" (fully local, no key), or "openai"
LLM_PROVIDER=groq

# Groq — free tier, serves Llama models
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (if LLM_PROVIDER=ollama) — run models locally, zero API keys
# Requires a running Ollama server + `pip install -e '.[local]'`
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional: enables live web search during research
# TAVILY_API_KEY=tvly_your_key_here

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# Checkpointing: "memory" (default) or "sqlite" (durable, resumable across restarts;
# requires: pip install -e '.[persist]')
# CHECKPOINTER=sqlite
# SQLITE_PATH=ouroboros.db

# Optional: LangSmith tracing (opt-in, off by default)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls-your_key_here
# LANGSMITH_PROJECT=ouroboros

# Deployment / public-demo safety (for the web server)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# DEMO_MODE=true          # clamp resource usage for untrusted public traffic
# MAX_DEMO_CYCLES=8
# MAX_CONCURRENT_SESSIONS=5
